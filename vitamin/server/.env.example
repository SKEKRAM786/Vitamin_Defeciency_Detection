# Use 5001 so Flask (vitamin/backend app.py) can use 5000 for ML + chatbot.
PORT=5001
# Copy to server/.env and set your real URI. Do not commit server/.env.
# Local: mongodb://127.0.0.1:27017/vitamin_app
# Atlas: mongodb+srv://USER:ENCODED_PASSWORD@cluster.xxxxx.mongodb.net/vitamin_app?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/vitamin_app
